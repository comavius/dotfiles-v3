 }
 
+void MozcState::ScheduleCallback(
+    mozc::commands::SessionCommand session_command,
+    uint32_t delay_millisec) {
+  callback_command_ = std::move(session_command);
+  const uint64_t trigger_time =
+      now(CLOCK_MONOTONIC) + static_cast<uint64_t>(delay_millisec) * 1000;
+
+  if (!callback_event_) {
+    callback_event_ = engine_->instance()->eventLoop().addTimeEvent(
+        CLOCK_MONOTONIC, trigger_time, 0,
+        [this](EventSourceTime*, uint64_t) {
+          if (!callback_command_) {
+            return false;
+          }
+
+          mozc::commands::SessionCommand command =
+              std::move(*callback_command_);
+          callback_command_.reset();
+
+          mozc::commands::Output output;
+          if (!SendCommand(command, &output)) {
+            LOG(ERROR) << "Delayed Callback Command Failed";
+            return false;
+          }
+
+          ParseResponse(output);
+          // A callback in |output| may have rearmed this one-shot event.
+          return true;
+        });
+    return;
+  }
+
+  callback_event_->setTime(trigger_time);
+  callback_event_->setEnabled(true);
+  callback_event_->setOneShot();
+}
+
+void MozcState::CancelCallback() {
+  callback_command_.reset();
+  if (callback_event_) {
+    callback_event_->setEnabled(false);
+  }
+}
+
 void MozcState::SetUsage(const std::string& title,
                          const std::string& description) {
   title_ = title;
